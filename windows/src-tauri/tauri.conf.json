{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeFlow Windows",
  "version": "0.1.0",
  "identifier": "com.omesh7.freeflow.windows",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "FreeFlow Windows",
        "width": 600,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
